// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id                            String                      @id @default(cuid())
  employeeId                    String                      @unique
  name                          String
  email                         String                      @default("")
  personalEmail                 String                      @default("")
  department                    String
  manager                       String                      @default("")
  position                      String
  joinDate                      DateTime
  workAuthorizationStatus       String                      @default("Other Work Visa")
  staffWorkLocation             String                      @default("USA")
  employeeType                  String                      @default("Full time")
  contractWorkHours             Int?
  systemRole                    String                      @default("Employee")
  officeSchedule                Json?
  overallOverdueTasks           Int                         @default(0)
  probationPeriodStartDate      DateTime?
  probationPeriodEndDate        DateTime?
  monthlySalaryDuringProbation  Float?                      @default(1300)
  monthlySalaryAfterProbation   Float?                      @default(1400)
  onboardingChecklistAssigned   Boolean                     @default(true)
  systemAccessGmail             Boolean                     @default(true)
  systemAccessClickup           Boolean                     @default(true)
  systemAccessMoodle            Boolean                     @default(true)
  systemAccessGoogleDrive       Boolean                     @default(true)
  onboardingStep2Completed      Boolean                     @default(true)
  onboardingStep2Forms          Json                        @default("[]")
  onboardingStep3Completed      Boolean                     @default(true)
  onboardingStep3Forms          Json                        @default("[]")
  onboardingStep4Completed      Boolean                     @default(true)
  onboardingStep4Forms          Json                        @default("[]")
  onboardingStep5Completed      Boolean                     @default(true)
  professionalDevelopmentRecords Json                       @default("[]")
  onboardingStep6AnnualTracking Boolean                     @default(false)
  onboardingStep1UpdatedBy      String                      @default("System")
  onboardingStep1UpdatedAt      DateTime?
  onboardingStep1Notes          String?                     @db.Text
  preboardingSteps              Json                        @default("{}")
  onboardingStep2CompletedAt    DateTime?
  onboardingStep3CompletedAt    DateTime?
  onboardingStep4CompletedAt    DateTime?
  onboardingStep5CompletedAt    DateTime?
  onboardingStep6StartedAt      DateTime?
  onboardingStep6LastReviewAt   DateTime?
  weeklyRecords                 WeeklyRecord[]
  tasks                         Task[]
  evaluations                   Evaluation[]
  monthlyComments               MonthlyPerformanceComment[]
  incidentRecords               IncidentRecord[]
  timeOffRequests               TimeOffRequest[]
  trainingAssignments           EmployeeTrainingAssignment[]
  trainingCompletionRecords     TrainingCompletionRecord[]
  offboardingRecord             OffboardingRecord?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
}

model OffboardingRecord {
  id                String   @id @default(cuid())
  employeeId        String   @unique
  employee          Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  separationType    String   @default("Resignation")
  leaveType         String   @default("Active working notice")
  noticeDate        DateTime?
  lastWorkingDate   DateTime?
  hrResponsible     String   @default("")
  itResponsible     String   @default("")
  step1             Json     @default("{}")
  step2             Json     @default("{}")
  step3             Json     @default("{}")
  step4             Json     @default("{}")
  step5             Json     @default("{}")
  step6             Json     @default("{}")
  step7             Json     @default("{}")
  step8             Json     @default("{}")
  completionPercent Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([updatedAt])
}

enum TimeOffType {
  PTO
  SICK_LEAVE
  PERSONAL_LEAVE_UNPAID
  JURY_DUTY
  MEDICAL_LEAVE
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TimeOffRequest {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestType TimeOffType
  status      TimeOffStatus @default(PENDING)
  startDate   DateTime
  endDate     DateTime
  hours       Float?
  reason      String?       @db.Text
  managerNote String?       @db.Text
  approvedAt  DateTime?
  plannedHoursAdjustedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  year      Int
  workLocation String @default("USA")
  isPaid    Boolean  @default(true)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, date, workLocation])
  @@index([year, date])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskCompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  OVERDUE
}

model Task {
  id               String               @id @default(cuid())
  employeeId       String
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title            String
  description      String?              @db.Text
  priority         TaskPriority         @default(MEDIUM)
  completionStatus TaskCompletionStatus @default(NOT_STARTED)
  isCompleted      Boolean              @default(false)
  dueDate          DateTime?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([employeeId])
  @@index([employeeId, completionStatus])
  @@index([employeeId, priority])
  @@index([dueDate])
}

model Evaluation {
  id                 String   @id @default(cuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart        DateTime
  periodEnd          DateTime
  evaluatorName      String
  evaluationScore    Float
  taskCompletionRate Float    @default(0)
  overdueTaskCount   Int      @default(0)
  strengths          String?  @db.Text
  improvementAreas   String?  @db.Text
  comments           String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([employeeId])
  @@index([employeeId, periodStart, periodEnd])
  @@index([evaluationScore])
}

enum IncidentRecordType {
  MISTAKE
  WARNING
}

enum IncidentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum IncidentAppealDecision {
  PENDING
  APPROVED
  DECLINED
}

enum IncidentFinalAction {
  NONE
  HOUR_REDUCTION
  SALARY_CUT
  TERMINATION
}

enum IncidentHistoryType {
  NOTE
  APPEAL
  SYSTEM
  MANAGER_COMMENT
}

model IncidentRecord {
  id                      String                 @id @default(cuid())
  employeeId              String
  employee                Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name                    String
  department              String
  manager                 String
  recordType              IncidentRecordType
  occurrenceDate          DateTime
  issuedBy                String
  reason                  String                 @db.Text
  status                  IncidentStatus         @default(PENDING)
  appealDecision          IncidentAppealDecision @default(PENDING)
  decisionDate            DateTime?
  reviewedBy              String?
  finalAction             IncidentFinalAction    @default(NONE)
  isAutoGenerated         Boolean                @default(false)
  meetingCompleted        Boolean                @default(false)
  emailSent               Boolean                @default(false)
  followUpEmailSent       Boolean                @default(false)
  improvementPlanReceived Boolean                @default(false)
  pipAdjustmentAgreementSent Boolean             @default(false)
  histories               IncidentHistory[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([employeeId, status, recordType])
  @@index([occurrenceDate])
}

model IncidentHistory {
  id         String              @id @default(cuid())
  incidentId String
  incident   IncidentRecord      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  memo       String              @db.Text
  type       IncidentHistoryType
  createdAt  DateTime            @default(now())
  createdBy  String

  @@index([incidentId, createdAt])
}

model WeeklyRecord {
  id                     String   @id @default(cuid())
  employeeId             String
  employee               Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate              DateTime
  endDate                DateTime
  plannedWorkHours       Float
  actualWorkHours        Float
  assignedTasks          Int
  assignedTasksDetails   Json     @default("[]") // JSON array storing assigned task priority breakdown
  weeklyOverdueTasks     Int
  overdueTasksDetails    Json     @default("[]") // JSON array storing priority breakdown
  allOverdueTasks        Int      @default(0) // Total overdue tasks from all previous weeks
  allOverdueTasksDetails Json     @default("[]") // JSON array storing priority breakdown for all overdue tasks
  managerComment         String?  @db.Text // Optional manager comment for performance evaluation
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([employeeId])
}

model MonthlyPerformanceComment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  comment    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@index([employeeId])
}

enum TrainingCategory {
  WUC_REQUIRED_TRAINING
  CALIFORNIA_REQUIRED_TRAINING
  ACCREDITATION_COMPLIANCE_TRAINING
  FACULTY_TRAINING
  CLINIC_SAFETY_TRAINING
  PROFESSIONAL_DEVELOPMENT
  OTHER
}

enum TrainingRequirementType {
  REQUIRED
  OPTIONAL
}

enum TrainingAudience {
  ALL_EMPLOYEES
  EMPLOYEES
  MANAGERS
  HR_ADMINS
  EXECUTIVES
  CALIFORNIA_NON_SUPERVISORY_EMPLOYEES
  CALIFORNIA_SUPERVISORS_MANAGERS
  APPLICABLE_CALIFORNIA_EMPLOYEES
  FACULTY
  EDUCATIONAL_ADMINISTRATORS
  CLINIC_PERSONNEL
  EMPLOYEES_WITH_OCCUPATIONAL_EXPOSURE
  ONLINE_HYBRID_FACULTY
  DISTANCE_EDUCATION_ADMINISTRATORS
  LICENSED_ACUPUNCTURISTS
  CUSTOM_GROUP
}

enum TrainingRecurrence {
  ONE_TIME
  ANNUAL
  EVERY_2_YEARS
  CUSTOM
}

enum TrainingIntervalUnit {
  DAYS
  MONTHS
  YEARS
}

enum TrainingMethod {
  WUC_INTERNAL_COURSE
  EXTERNAL_TRAINING
  CERTIFICATE_RECORD_TRACKING
  PROFESSIONAL_DEVELOPMENT_RECORD
}

enum TrainingCompletionMethod {
  EXAM_SCORE
  CERTIFICATE
  HOURS_EVIDENCE_REQUIREMENT
  HOURS_CE_REQUIREMENT
  HR_VERIFICATION
}

enum TrainingProgramStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TrainingCycleStatus {
  CURRENT
  UPCOMING
  ARCHIVED
}

enum TrainingAssignmentStatus {
  ASSIGNED
  COMPLETED
  WAIVED
  CANCELLED
}

model TrainingProgram {
  id                      String                     @id @default(cuid())
  programCode             String?                    @unique
  trainingName            String
  category                TrainingCategory
  requirementType         TrainingRequirementType    @default(REQUIRED)
  appliesTo               TrainingAudience[]
  customGroupName         String?
  startDate               DateTime
  dueDate                 DateTime
  recurrence              TrainingRecurrence
  recurrenceIntervalValue Int?
  recurrenceIntervalUnit  TrainingIntervalUnit?
  nextCycleDate           DateTime?
  trainingMethod          TrainingMethod
  completionMethod        TrainingCompletionMethod
  examRequired            Boolean                    @default(false)
  passingScore            Float?
  certificateRequired     Boolean                    @default(true)
  status                  TrainingProgramStatus      @default(DRAFT)
  cycles                  TrainingCycle[]
  assignments             EmployeeTrainingAssignment[]
  completionRecords       TrainingCompletionRecord[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([category])
  @@index([requirementType])
  @@index([status])
}

model TrainingCycle {
  id               String                     @id @default(cuid())
  trainingProgramId String
  trainingProgram  TrainingProgram            @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  cycleStartDate   DateTime
  cycleDueDate     DateTime
  status           TrainingCycleStatus        @default(CURRENT)
  sequence         Int                        @default(1)
  windowDays       Int                        @default(0)
  assignments      EmployeeTrainingAssignment[]
  completionRecords TrainingCompletionRecord[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([trainingProgramId, cycleStartDate])
  @@index([trainingProgramId, status])
}

model EmployeeTrainingAssignment {
  id                 String                  @id @default(cuid())
  employeeId         String
  employee           Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainingProgramId  String
  trainingProgram    TrainingProgram         @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  trainingCycleId    String
  trainingCycle      TrainingCycle           @relation(fields: [trainingCycleId], references: [id], onDelete: Cascade)
  assignedDate       DateTime
  dueDate            DateTime
  status             TrainingAssignmentStatus @default(ASSIGNED)
  completionDate     DateTime?
  examScore          Float?
  certificateReference String?
  notes              String?                 @db.Text
  completionRecords  TrainingCompletionRecord[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([employeeId, trainingProgramId, trainingCycleId])
  @@index([employeeId, dueDate])
  @@index([status])
}

model TrainingCompletionRecord {
  id                  String                    @id @default(cuid())
  employeeId          String
  employee            Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainingProgramId   String
  trainingProgram     TrainingProgram           @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  trainingCycleId     String
  trainingCycle       TrainingCycle             @relation(fields: [trainingCycleId], references: [id], onDelete: Cascade)
  assignmentId        String?
  assignment          EmployeeTrainingAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  completedAt         DateTime
  examScore           Float?
  certificateReference String?
  notes               String?                   @db.Text
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([employeeId, completedAt])
  @@index([trainingProgramId, completedAt])
}
