# Local development environment (Mac/Windows/Linux local DB)
# Copy to .env.local and fill with local credentials.

DATABASE_URL="postgresql://your_local_db_user:your_local_db_password@localhost:5432/hrperformance"

# Auth.js / Google OAuth. Add http://localhost:3001/api/auth/callback/google
# as an authorized redirect URI in your Google OAuth web client.
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
AUTH_SECRET=generate_a_random_secret_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true

# Gemini API key for AI comments
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_smtp_app_password_here
SMTP_SECURE=false
HR_EMAIL_FROM="Human Resources <your_email@yourdomain.com>"
